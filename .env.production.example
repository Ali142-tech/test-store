# PRODUCTION TEMPLATE - placeholders only. Copy to .env on the server, then fill in real values.
# NEVER commit the real .env. Generate the key on the server: php artisan key:generate --force

APP_NAME="Your Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database: use a dedicated MySQL user with privileges on this schema only (no GRANT/SUPER).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=store
DB_USERNAME=store_app
DB_PASSWORD=CHANGE_ME

# Sessions / cache / queue (Redis recommended in production; database works for small stores)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (transactional + marketing). Use a real provider (SES, Mailgun, SMTP...).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=orders@shop.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Product images: "public" (local, needs `php artisan storage:link`) or "s3" (S3-compatible)
MEDIA_DISK=public
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Online payment gateways: leave unset until you have merchant credentials AND have implemented the adapter.
# See docs/PAYMENTS.md. Example placeholders for a future adapter:
# PAYMENT_CARD_PROVIDER=
# PAYMENT_CARD_MERCHANT_ID=
# PAYMENT_CARD_SECRET=
# PAYMENT_CARD_WEBHOOK_SECRET=
